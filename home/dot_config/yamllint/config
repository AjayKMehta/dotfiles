---

extends: default

rules:
  comments:
    ignore-shebangs: true
    min-spaces-from-content: 1
  document-start: disable
  line-length: disable
  empty-values: enable
  new-lines:
    type: platform
    level: warning
  quoted-strings:
    quote-type: any
    required: only-when-needed
    extra-allowed: []
    extra-required: [^http://, ^ftp://]
