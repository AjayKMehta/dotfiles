PATH="${RTOOLS45_HOME}\usr\bin;${RTOOLS45_HOME}\ucrt64\bin;${RTOOLS45_HOME}\mingw64\bin;${PATH}"

plotly_username=AjayKMehta
plotly_api_key={{- (gopass "PLOTLY/AjayKMehta") }}

QUANDL_API_KEY={{- (gopass "QUANDL_API_KEY") }}
GOOGLE_MAPS_API_KEY={{- (gopass "GOOGLE_MAPS_API")}}
RIINGO_TOKEN={{- (gopass "RIINGO_TOKEN") }}
GGMAP_GOOGLE_API_KEY={{- (gopass "GOOGLE_MAPS_API")}}

# https://wlandau.github.io/instantiate/#administering-cmdstan
{{if .cmdstandir }}CMDSTAN="{{- .cmdstandir }}"{{end}}
CMDSTAN_INSTALL="fixed"

LC_COLLATE=English_United States.utf8
LC_CTYPE=English_United States.utf8
LC_MONETARY=English_United States.utf8
# LC_NUMERIC=C
LC_NUMERIC=English_United States.utf8
LC_TIME=English_United States.utf8

# https://joshuamarie.com/posts/05-pipes/#the-native-pipe-r-v4.1-2021
_R_USE_PIPEBIND_=true

# https://remlapmot.github.io/post/2026/stan-compile-speedup/
MAKEFLAGS=-j10
