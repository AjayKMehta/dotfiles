{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "{{ .Env.OSC99 }}"
        },
        {
          "options": {
            "root_icon": "⚡"
          },
          "style": "powerline",
          "template": " \uf0e7 ",
          "foreground": "#ffeb3b",
          "powerline_symbol": "\ue0b0",
          "background": "#bd0505",
          "type": "root"
        },
        {
          "type": "winget",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#ffffff",
          "background": "#0077c2",
          "template": "  {{ .UpdateCount }} ",
          "cache": {
            "duration": "none",
            "strategy": "device"
          }
        },
        {
          "style": "powerline",
          "template": " \ue61f {{ .Full }} ",
          "foreground": "#49eb33",
          "powerline_symbol": "\ue0b0",
          "background": "#100e23",
          "type": "haskell",
          "cache": {
            "duration": "1h",
            "strategy": "folder"
          }
        },
        {
          "style": "powerline",
          "template": " \ue70c {{ if .Unsupported }}\uf071{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b0",
          "background": "#AAEFFF",
          "type": "dotnet",
          "cache": {
            "duration": "1h",
            "strategy": "folder"
          }
        },
        {
          "style": "powerline",
          "template": " R {{ .Full }} ",
          "foreground": "blue",
          "powerline_symbol": "\ue0b0",
          "background": "lightWhite",
          "type": "r",
          "cache": {
            "duration": "1h",
            "strategy": "device"
          }
        },
        {
          "options": {
            "display_mode": "context",
            "tooling": [
              "uv"
            ]
          },
          "style": "powerline",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "foreground": "#100e23",
          "powerline_symbol": "\ue0b0",
          "background": "#906cff",
          "type": "python",
          "cache": {
            "duration": "1h",
            "strategy": "folder"
          }
        },
        {
          "type": "copilot",
          "style": "powerline",
          "foreground": "#111111",
          "background": "#fee898",
          "template": " 🤖 {{ .Chat.Used }}/{{ .Chat.Limit }} ",
          "cache": {
            "duration": "5m",
            "strategy": "session"
          },
          "options": {
            "http_timeout": 5000
          }
        },
        {
          "options": {
            "folder_icon": "\uf115",
            "folder_separator_icon": " \ue0b1 ",
            "home_icon": "\uf015",
            "max_depth": 3,
            "style": "agnoster"
          },
          "style": "powerline",
          "template": " {{ .Path }} ",
          "foreground": "#FFFFFF",
          "powerline_symbol": "\ue0b0",
          "background": "#22a4d3",
          "type": "path"
        },
        {
          "options": {
            "fetch_status": true,
            "fetch_push_status": true,
            "fetch_upstream_icon": true,
            "native_fallback": true,
            "untracked_modes": {
              "*": "all"
            }
          },
          "style": "powerline",
          "template": " {{ url .UpstreamIcon .UpstreamURL }}{{ trunc 30 .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <#FF479C>\uf044 {{ .Working.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} <#35FF00>\uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} <#009AFF>\ueb4b {{ .StashCount }}{{ end }}</>{{ if gt .WorktreeCount 0 }} \uf1bb {{ .WorktreeCount }}{{ end }}",
          "foreground": "#193549",
          "powerline_symbol": "\ue0b0",
          "background": "#53ca53",
          "type": "git",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFAA3B{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FFEAAF{{ end }}",
            "{{ if gt .Ahead 0 }}#00FFFF{{ end }}",
            "{{ if gt .Behind 0 }}#FAA0AE{{ end }}"
          ]
        },
        {
          "style": "powerline",
          "template": "{{ if .Env.POSH }} {{ if eq .Env.POSH \"True\"}}\uf0c7{{end}} {{end}}",
          "foreground": "transparent",
          "powerline_symbol": "\ue0b0",
          "background": "#a8cdc9",
          "type": "text"
        }
      ]
    }
  ],
  "version": 4,
  "auto_upgrade": true,
  "shell_integration": true,
  "patch_pwsh_bleed": true,
  "final_space": true,
  "pwd": "osc99",
  "upgrade": {
    "notice": true,
    "interval": "72h",
    "auto": false,
    "source": "github"
  },
  "streaming": 100
}
