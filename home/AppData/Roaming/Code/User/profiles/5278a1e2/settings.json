{
    "[gitattributes]": {
        "editor.defaultFormatter": "hashhar.gitattributes"
    },
    "[gitconfig]": {
        "editor.defaultFormatter": "yy0931.gitconfig-lsp"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[go-template]": {
        "files.insertFinalNewline": false
    },
    "[json]": {
        "editor.autoClosingBrackets": "always",
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnPaste": false
    },
    "[jsonc]": {
        "editor.autoClosingBrackets": "always",
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[lua]": {
        "editor.defaultFormatter": "sumneko.lua"
    },
    "[markdown]": {
        "diffEditor.ignoreTrimWhitespace": true,
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "editor.fontFamily": "'DejaVuSansM Nerd Font', Consolas, 'Courier New', monospace, 'Lucida Sans'",
        "editor.formatOnSave": false,
        "editor.wordWrap": "on",
        "files.trimTrailingWhitespace": false
    },
    "[powershell]": {
        "editor.defaultFormatter": "ms-vscode.powershell",
        "editor.fontLigatures": false
    },
    "[quarto]": {
        "editor.defaultFormatter": "quarto.quarto"
    },
    "[shellscript]": {
        "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode"
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml",
        "editor.fontLigatures": false
    },
    "[xslt]": {
        "editor.semanticHighlighting.enabled": true
    },
    "[yaml]": {
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.fontLigatures": false
    },
    "chat.viewSessions.orientation": "stacked",
    "code-runner.showRunIconInEditorTitleMenu": false,
    "debug.inlineValues": "on",
    "diffEditor.codeLens": true,
    "diffEditor.diffAlgorithm": "advanced",
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.wordWrap": "on",
    "dotfiles.repository": "https://github.com/AjayKMehta/dotfiles",
    "editor.bracketPairColorization.enabled": true,
    "editor.colorDecoratorsLimit": 5000,
    "editor.defaultColorDecorators": "auto",
    "editor.definitionLinkOpensInPeek": true,
    "editor.fontFamily": "'FiraCode Nerd Font Mono', 'Cascadia Code', Consolas, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.largeFileOptimizations": false,
    "editor.minimap.autohide": "mouseover",
    "editor.minimap.renderCharacters": false,
    "editor.minimap.scale": 3,
    "editor.quickSuggestions": {
        "comments": true,
        "other": true,
        "strings": true
    },
    "editor.renderWhitespace": "all",
    "editor.rulers": [
        80
    ],
    "editor.suggest.preview": true,
    "editor.tokenColorCustomizations": {
        "[Ayu Dark Bordered]": {
            "comments": "#229977"
        }
    },
    "editor.wordWrap": "on",
    "errorLens.disableLineComments": {
        "markdownlint": "<!-- markdownlint-disable-line $code SAME_LINE -->"
    },
    "errorLens.enabled": false,
    "files.autoSave": "onFocusChange",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/*.html": true,
        "**/*_cache": true,
        "**/.history/**": true
    },
    "files.trimTrailingWhitespace": true,
    "fontAwesomeAutocomplete.version": "6",
    "git-graph.customEmojiShortcodeMappings": [],
    "github.copilot.enable": {
        "*": false,
        "lua": false,
        "markdown": false,
        "plaintext": false,
        "quarto": false,
        "scminput": false,
        "yaml": false
    },
    "github.copilot.nextEditSuggestions.eagerness": "low",
    "github.copilot.nextEditSuggestions.enabled": false,
    "githubLocalActions.dockerDesktopPath": "C:/Program Files/Docker/Docker/Docker Desktop.exe",
    "Lua.codeLens.enable": true,
    "Lua.hint.enable": true,
    "markdown-preview-enhanced.alwaysShowBacklinksInPreview": true,
    "markdown-preview-enhanced.codeBlockTheme": "solarized-light.css",
    "markdown-preview-enhanced.enablePreviewZenMode": false,
    "markdown-preview-enhanced.pandocPath": "D:\\Apps\\Quarto\\bin\\tools\\pandoc.exe",
    "markdown-table-formatter.keepFirstAndLastPipes": false,
    "markdown-table-formatter.markdownGrammarScopes": [
        "markdown",
        "quarto",
        "rmarkdown"
    ],
    "markdown.extension.completion.respectVscodeSearchExclude": true,
    "markdown.extension.extraLangIds": [
        "quarto",
        "rmd"
    ],
    "markdown.extension.list.toggle.candidate-markers": [
        "*",
        "-",
        "1."
    ],
    "markdown.extension.math.enabled": false,
    "notebook.cellExecutionTimeVerbosity": "verbose",
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "notebook.lineNumbers": "on",
    "notebook.outline.showCodeCells": true,
    "notebook.showFoldingControls": "always",
    "pasteImage.path": "${currentFileDir}/images",
    "pasteImage.showFilePathConfirmInputBox": true,
    "powershell.codeFormatting.addWhitespaceAroundPipe": true,
    "powershell.codeFormatting.ignoreOneLineBlock": true,
    "powershell.codeFormatting.pipelineIndentationStyle": "IncreaseIndentationForFirstPipeline",
    "powershell.codeFormatting.preset": "OTBS",
    "powershell.codeFormatting.trimWhitespaceAroundPipe": true,
    "powershell.codeFormatting.useConstantStrings": true,
    "powershell.codeFormatting.useCorrectCasing": true,
    "powershell.codeFormatting.whitespaceBetweenParameters": true,
    "powershell.debugging.createTemporaryIntegratedConsole": true,
    "powershell.integratedConsole.focusConsoleOnExecute": false,
    "powershell.integratedConsole.forceClearScrollbackBuffer": true,
    "powershell.integratedConsole.suppressStartupBanner": true,
    "powershell.pester.codeLens": false,
    "powershell.promptToUpdatePowerShell": false,
    "print.folder.include": [],
    "print.folder.includeFileList": false,
    "quarto.render.previewReveal": false,
    "remote.autoForwardPortsSource": "hybrid",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.fontFamily": "FiraCode Nerd Font Mono",
    "terminal.integrated.sendKeybindingsToShell": true,
    "versionlens.dotnet.caching.duration": 3,
    "versionlens.suggestions.showOnStartup": true,
    "vsicons.dontShowNewVersionMessage": true,
    "vsicons.presets.foldersAllDefaultIcon": true,
    "window.commandCenter": true,
    "workbench.activityBar.location": "top",
    "workbench.editor.labelFormat": "default",
    "workbench.iconTheme": "vscode-icons",
    "workbench.tree.renderIndentGuides": "always"
}
