{
    "highlight_selected_line": true,
    "continue_comments_on_newline": true,
    "check_arguments_to_r_function_calls": true,
    "auto_append_newline": true,
    "syntax_color_console": true,
    "highlight_r_function_calls": true,
    "editor_theme": "Night Owl {rsthemes}",
    "default_encoding": "UTF-8",
    "document_author": "Ajay Mehta",
    "show_rmd_render_command": true,
    "remove_history_duplicates": true,
    "reuse_sessions_for_project_links": true,
    "console_double_click_select": true,
    "style_diagnostics": true,
    "rmd_viewer_type": "pane",
    "windows_terminal_shell": "custom",
    "custom_shell_command": "C:/Program Files/PowerShell/7/pwsh.exe",
    "jobs_tab_visibility": "shown",
    "cran_mirror": {
        "name": "Global (CDN)",
        "host": "RStudio",
        "url": "https://cran.rstudio.com/",
        "country": "us",
        "ok": 1,
        "secondary": ""
    },
    "full_project_path_in_window_title": true,
    "show_last_dot_value": true,
    "check_unexpected_assignment_in_function_call": true,
    "initial_working_directory": "{{ .rworkingdir }}",
    "rainbow_parentheses": true,
    "tab_multiline_completion": true,
    "show_diagnostics_other": true,
    "show_doc_outline_rmd": true,
    "warn_variable_defined_but_not_used": true,
    "auto_detect_indentation": true,
    "visual_markdown_editing_show_margin": true,
    "visual_markdown_code_editor_line_numbers": true,
    "doc_outline_show": "sections_and_chunks",
    "pdf_previewer": "none",
    "default_latex_program": "XeLaTeX",
    "graphics_backend": "cairo-png",
    "insert_native_pipe_operator": true,
    "reformat_on_save": true,
    "code_formatter": "external",
    "show_help_tooltip_on_idle": true,
    "code_formatter_external_command": "air.exe format",
    "copilot_enabled": true,
    "copilot_indexing_enabled": true,
    "copilot_completions_trigger": "manual",
    "editor_line_height": 100,
    "default_project_location": "{{ .rworkingdir }}",
    "strip_trailing_whitespace": true,
    "toolbar_visible": false,
    "source_with_echo": true,
    "autohide_menubar": true,
    "default_open_project_location": "{{ .rworkingdir }}",
    "margin_column": 100,
    "margin_column_soft_wrap": true,
    "indent_guides": "rainbowlines",
    "panes": {
        "quadrants": [
            "Source",
            "Console",
            "TabSet1",
            "TabSet2"
        ],
        "tabSet1": [
            "Environment",
            "History",
            "Connections",
            "Build",
            "VCS",
            "Tutorial",
            "Presentation"
        ],
        "tabSet2": [
            "Files",
            "Plots",
            "Packages",
            "Help",
            "Viewer",
            "Presentations"
        ],
        "hiddenTabSet": [],
        "console_left_on_top": false,
        "console_right_on_top": true,
        "additional_source_columns": 0,
        "sidebar": [
            "Chat"
        ],
        "sidebar_visible": false,
        "sidebar_location": "right"
    }
}
